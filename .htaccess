# Root .htaccess for running the app from the project folder (e.g. XAMPP http://localhost/bhudevsetu/).
# Only public/ is ever served directly; every other path is handed to Laravel, which 404s unknown files.
# For production, point the VirtualHost DocumentRoot at public/ instead and this file is not needed.

# Any path segment starting with a dot (.env, .git/, .htaccess ...) is never served.
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/\.(?!well-known/)
</IfModule>

# Project metadata must never be readable even if mod_rewrite is unavailable.
<FilesMatch "(?i)^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan|vite\.config\.js|.*\.(md|ps1|lock|sqlite|log))$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Static files that live in public/: assets, the storage symlink, Vite build output, favicon. robots.txt and sitemap.xml are generated by the app.
    RewriteRule ^(assets|storage|build)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|favicon\.svg)$ public/$1 [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Everything else goes to the front controller, including requests for real files
    # such as /vendor, /tests, /storage/logs or /composer.json. Laravel returns 404 for them.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
